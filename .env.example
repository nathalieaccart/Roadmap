JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=paste-your-local-api-token-here
JIRA_PROJECT_KEY=ROAD

# Optional folder for editable roadmap issue files. Set this to a Drive folder
# path if you want the same files available from your synced drive.
# ROADMAP_DATA_DIR=C:\Users\you\OneDrive\Roadmap

# Jira's default Start date field in many Jira Software projects.
# Set to an empty value to omit start dates if the field is unavailable.
JIRA_START_DATE_FIELD=customfield_10015
JIRA_END_DATE_FIELD=duedate

# Optional Jira custom-field ID for the issue domain, such as customfield_10100.
# Leave empty to hide the domain tag for live Jira issues.
JIRA_DOMAIN_FIELD=

# Optional Jira custom-field ID for Business on live issues.
JIRA_SPONSOR_FIELD=

# Optional: customize the issue scope. The default lists non-subtask issues
# from the configured project, ordered by Jira Rank.
# JIRA_JQL=project = "{project_key}" AND statusCategory != Done ORDER BY Rank ASC

# Optional request timeout, in seconds.
JIRA_TIMEOUT_SECONDS=15
